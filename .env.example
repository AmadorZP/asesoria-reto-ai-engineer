# Copia este archivo como .env y completa los valores. El .env nunca se sube al repo.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=
ADVISOR_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6.1-terra
EMBEDDING_MODEL=text-embedding-3-large

# --- Alpaca (paper trading) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# --- SEC EDGAR ---
# La SEC exige identificar al solicitante: "Nombre Apellido correo@dominio.com"
SEC_USER_AGENT=
